{
  "name": "femsa-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3040",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3040",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test:ui": "node scripts/verify.mjs",
    "test:inventory": "python3 scripts/test_inventory.py && node --experimental-strip-types scripts/test-inventory.mjs",
    "test:dashboard": "node scripts/verify-dashboard.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "^0.468.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "@playwright/test": "^1.56.0"
  }
}
